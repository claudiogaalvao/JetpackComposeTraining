<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/event_cover"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:src="@drawable/reuniao_congresso"
        android:contentDescription="reuniao congresso"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/labels_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/event_cover"
        app:layout_constraintStart_toStartOf="parent"
        android:paddingTop="8dp"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/deliberative_event_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DELIBERATIVO"
            android:background="@android:color/holo_blue_dark"
            android:textColor="@android:color/black"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/event_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ENCERRADA"
            android:background="@android:color/darker_gray"
            android:textColor="@android:color/black"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/event_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GRAVACAO"
            android:background="@android:color/darker_gray"
            android:textColor="@android:color/black"
            android:padding="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/event_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reunião Deliberativa"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/labels_group"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/event_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Discussão de votação de propostas"
        app:layout_constraintTop_toBottomOf="@+id/event_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/event_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOJE, 30 MAIO • 9:00"
        app:layout_constraintTop_toBottomOf="@+id/event_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@android:color/holo_orange_dark"
        android:layout_marginStart="8dp" />

    <TextView
        android:id="@+id/event_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anexo II, Plenário 04"
        app:layout_constraintTop_toBottomOf="@+id/event_date"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="@android:color/black"
        android:layout_marginStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>